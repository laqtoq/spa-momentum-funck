# Local API key storage — personal convenience only.
# Copy to `.env` and fill in. `.env` is gitignored; this repo is public.
#
# IMPORTANT: the app does NOT read this file — keys are entered in the app's
# form fields at runtime (HANDOVER §7). This is your copy-paste note file.
# NEVER rename these with a VITE_ prefix: Vite would inline them into the
# public bundle at build time.

FMP_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
NEWS_DATA_IO_API_KEY=
NEWSAPI_API_KEY=
OPENROUTER_API_KEY=
